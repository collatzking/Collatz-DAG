-- ============================================================================
-- 9. Universal Power of Two Remainder Tracking
-- ============================================================================
theorem odd_power_two_sequence (n : Nat) (k : Nat) (hx : n % 3 ≠ 0) :
(n * 2^k) % 3 = 1 ∨ (n * 2^k) % 3 = 2 := by
 induction k generalizing n with
 | zero =>
   have h_rem : n % 3 = 1 ∨ n % 3 = 2 := by omega
   cases h_rem with
   | inl h1 =>
     left
     rw [pow_zero, mul_one]
     exact h1
   | inr h2 =>
     right
     rw [pow_zero, mul_one]
     exact h2
 | succ k ih =>
   have h_mul : n * 2^(k + 1) = (n * 2^k) * 2 := by ring
   rw [h_mul]
   have h_prev := ih n hx
   cases h_prev with
   | inl _h1 => omega
   | inr _h2 => omega

