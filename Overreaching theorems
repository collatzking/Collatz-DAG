-- ============================================================================
-- 15. Universal Wrapper for All Positive Integers
-- ============================================================================
theorem reduce_to_odd_is_odd (n : Nat) (h_pos : n > 0) : IsOdd (reduceToOdd n) := by
 induction n using Nat.strong_induction_on with
 | h n ih =>
   unfold reduceToOdd
   split_ifs with h_even
   · have h_lt : n / 2 < n := by omega
     have h_half_pos : n / 2 > 0 := by omega
     exact ih (n / 2) h_lt h_half_pos
   · unfold IsOdd
     omega

theorem reduce_to_odd_pos (n : Nat) (h_pos : n > 0) : reduceToOdd n > 0 := by
 induction n using Nat.strong_induction_on with
 | h n ih =>
   unfold reduceToOdd
   split_ifs with h_even
   · have h_lt : n / 2 < n := by omega
     have h_half_pos : n / 2 > 0 := by omega
     exact ih (n / 2) h_lt h_half_pos
   · exact h_pos

theorem all_integers_trajectory (n : Nat) (h_pos : n > 0) :
∃ next_node : Nat, custom_step (reduceToOdd n) = next_node := by
 have h_reduce_pos : reduceToOdd n > 0 := reduce_to_odd_pos n h_pos
 exact inverse_step_reverses_forward (reduceToOdd n) h_reduce_pos (mod_three_cases (reduceToOdd n))

